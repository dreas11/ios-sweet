-		return EIO;
+		goto failed;
 	}
 	rh_write(rh_tcs, b + RH_CONTROL, RH_AMC_EN | RH_TRIGGER);
 	bool done = false;
@@ -122,22 +154,27 @@
 	    t, address, done, irq, idle, status);
 	if (!done) {
 		printf("SWEET RPMH: ARC timeout; slot quarantined, no retry or power writes\n");
-		return ETIMEDOUT;
+		error = ETIMEDOUT;
+		goto failed;
 	}
 	/* Downstream RSC_DRV_CMD_RESP_DATA, not the request DATA register. */
 	uint32_t value = rh_read(rh_tcs, b + 0x40);
 	if (!rh_sync(b + RH_CONTROL, RH_AMC_EN) || !rh_sync(b + RH_CONTROL, 0) ||
 	    !rh_sync(b + RH_ENABLE, 0) || !rh_sync(b + RH_WAIT, 0)) {
-		return EIO;
+		goto failed;
 	}
 	rh_write(rh_tcs, RH_IRQ_CLEAR, bit);
