--- /dev/null
+++ b/bsd/dev/sweet_gpu_gmu_branch.h
@@ -0,0 +1,99 @@
+/* SM7150 CX_GMU branch cycle with CM3 held in reset. No GMU register writes.
+ * Xiaomi 758bb7ef: gpucc-sdmmagpie.c, clk-branch.c, adreno_a6xx_gmu.c.
+ * Caller has verified/powered CX and forced the nominal 200-MHz root on.
+ */
+#ifndef SWEET_GPU_GMU_BRANCH_H
+#define SWEET_GPU_GMU_BRANCH_H
+#include <stdint.h>
+#include <stdbool.h>
+#define SGB_CX 0x1098u
+#define SGB_OFF (1u << 31)
+#define SGB_WAKE_SLEEP 0xff0u
+struct sweet_gpu_gmu_io {
+	void *cookie;
+	uint32_t (*cc_read)(void *, unsigned);
+	void (*cc_write)(void *, unsigned, uint32_t);
+	uint32_t (*gmu_read)(void *, bool, unsigned); /* AO or CM3, page-relative */
+	void (*delay)(unsigned);
+};
+struct sweet_gpu_gmu_result {
+	uint32_t ahb, cx_hw, root_cmd, root_cfg, before, running, after;
+	uint32_t fence, reset_before, reset_after, fw_result, cm3_cfg;
+	bool registers_read, changed, clock_running, restored, safe_to_stop_root;
+};
+enum { SGB_OK, SGB_GUARD, SGB_IO, SGB_TIMEOUT, SGB_RESTORE, SGB_RESET_UNSAFE };
+static inline bool
+sgb_poll(const struct sweet_gpu_gmu_io *io, bool on)
+{
+	for (unsigned us = 0; us < 500; us++) {
+		uint32_t v = io->cc_read(io->cookie, SGB_CX);
+		if (v == 0xffffffffu) { return false; }
+		if ((v & (SGB_OFF | 1u)) == (on ? 1u : SGB_OFF)) { return true; }
+		io->delay(1);
+	}
+	return false;
+}
+static inline int
+sweet_gpu_gmu_branch_cycle(const struct sweet_gpu_gmu_io *io,
+    struct sweet_gpu_gmu_result *r)
+{
+	*r = (struct sweet_gpu_gmu_result){0};
+	r->safe_to_stop_root = true;
+	r->ahb = io->cc_read(io->cookie, 0x1078);
+	r->cx_hw = io->cc_read(io->cookie, 0x1540);
+	r->root_cmd = io->cc_read(io->cookie, 0x1120);
+	r->root_cfg = io->cc_read(io->cookie, 0x1124);
+	r->before = io->cc_read(io->cookie, SGB_CX);
+	if (r->ahb == 0xffffffffu || (r->ahb & (SGB_OFF | 1u)) != 1u ||
+	    r->cx_hw == 0xffffffffu || !(r->cx_hw & SGB_OFF) ||
+	    r->root_cmd == 0xffffffffu || (r->root_cmd & (SGB_OFF | 3u)) != 2u ||
+	    r->root_cfg == 0xffffffffu || (r->root_cfg & 0x10371fu) != 0x602u ||
+	    r->before == 0xffffffffu || (r->before & (SGB_OFF | 1u)) != SGB_OFF) {
+		return SGB_GUARD;
+	}
+	/* AO base 0x0508c000; enum offsets are GPU dwords, not byte offsets.
+	 * A6XX_GMU_AO_AHB_FENCE_CTRL at GPU word 0x23b10 => PA 0x0508ec40.
+	 * Do not change a fence to make an inaccessible register readable.
+	 */
+	r->fence = io->gmu_read(io->cookie, true, 0x2c40);
+	if (r->fence != 0) { return SGB_GUARD; }
+	/* CM3 base 0x0507c000: SYSRESET at 0x2000 must already be asserted.
+	 * The only GMU accesses here are ordinary read-only status registers.
+	 */
+	r->reset_before = io->gmu_read(io->cookie, false, 0x2000);
+	if (r->reset_before != 1) { return SGB_GUARD; }
+	r->fw_result = io->gmu_read(io->cookie, false, 0x2070);
+	r->cm3_cfg = io->gmu_read(io->cookie, false, 0x20b4);
+	r->registers_read = true;
+	if (r->fw_result == 0xffffffffu || r->cm3_cfg == 0xffffffffu) { return SGB_IO; }
+	r->changed = true;
+	r->safe_to_stop_root = false;
+	uint32_t prepared = (r->before & ~SGB_WAKE_SLEEP) | SGB_WAKE_SLEEP;
+	io->cc_write(io->cookie, SGB_CX, prepared);
+	uint32_t value = io->cc_read(io->cookie, SGB_CX);
+	int result = SGB_IO;
+	if (value == 0xffffffffu || (value & (SGB_WAKE_SLEEP | 1u)) != SGB_WAKE_SLEEP) {
+		goto restore;
+	}
+	io->cc_write(io->cookie, SGB_CX, prepared | 1u);
+	result = sgb_poll(io, true) ? SGB_OK : SGB_TIMEOUT;
+	r->running = io->cc_read(io->cookie, SGB_CX);
+	r->clock_running = result == SGB_OK && r->running != 0xffffffffu &&
+	    (r->running & (SGB_OFF | 1u)) == 1u;
+restore:
+	/* If reset is no longer known asserted, don't gate a possibly live CM3.
+	 * Retain branch/root/CX and stop; no retries, reset release or DMA.
+	 */
+	r->reset_after = io->gmu_read(io->cookie, false, 0x2000);
+	if (r->reset_after != 1) { return SGB_RESET_UNSAFE; }
+	value = io->cc_read(io->cookie, SGB_CX);
+	if (value == 0xffffffffu) { return SGB_RESTORE; }
+	io->cc_write(io->cookie, SGB_CX, value & ~1u);
+	if (!sgb_poll(io, false)) { return SGB_RESTORE; }
+	io->cc_write(io->cookie, SGB_CX, r->before);
+	r->after = io->cc_read(io->cookie, SGB_CX);
+	r->restored = r->after == r->before;
+	r->safe_to_stop_root = r->restored;
+	return r->restored ? result : SGB_RESTORE;
+}
+#endif
