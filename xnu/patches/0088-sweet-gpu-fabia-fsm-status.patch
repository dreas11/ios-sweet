+/* Fabia FSM/vote mode reports ACTIVE in MODE; software OPMODE may remain
+ * STANDBY. Direct mode instead requires OPMODE RUN. Never write the PLL.
+ * Xiaomi clk_fabia_pll_enable() uses this same FSM/direct distinction.
+ */
+static inline bool
+sgr_pll_running(uint32_t mode, uint32_t opmode)
+{
+	if (mode == 0xffffffffu || opmode == 0xffffffffu ||
+	    (mode & (SGR_OFF | 5u)) != (SGR_OFF | 5u)) { return false; }
+	return (mode & SGR_PLL_FSM) ? (mode & SGR_PLL_ACTIVE) != 0 : opmode == 1;
+}
