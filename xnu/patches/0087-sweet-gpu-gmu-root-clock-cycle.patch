--- /dev/null
+++ b/bsd/dev/sweet_gpu_clock.h
@@ -0,0 +1,147 @@
+/* SM7150 GMU root-only clock cycle. Caller has powered CX with adequate rails.
+ * No PLL retuning or GMU/GX branch enable. Source: Xiaomi 758bb7ef GPUCC/GCC,
+ * clk-rcg2.c, clk-alpha-pll.c and clk-branch.c. Values are register encodings.
+ */
+#ifndef SWEET_GPU_CLOCK_H
+#define SWEET_GPU_CLOCK_H
+#include <stdint.h>
+#include <stdbool.h>
+#define SGR_CMD 0x1120u
+#define SGR_CFG 0x1124u
+#define SGR_CX 0x1098u
+#define SGR_GX 0x1064u
+#define SGR_GATE 0x52004u
+#define SGR_GATE_BIT (1u << 16)
+#define SGR_OFF (1u << 31)
+#define SGR_UPDATE 1u
+#define SGR_FORCE 2u
+#define SGR_CFG_MASK 0x10371fu
+struct sweet_gpu_clock_io {
+	void *cookie;
+	uint32_t (*read)(void *, bool, unsigned); /* true: GCC, false: GPUCC */
+	void (*write)(void *, bool, unsigned, uint32_t);
+	void (*delay)(unsigned);
+};
+struct sweet_gpu_clock_result {
+	uint32_t pll_mode, pll_l, pll_frac, pll_user, pll_opmode;
+	uint32_t cmd_before, cfg_before, gate_before, cx_before, gx_before;
+	uint32_t cmd_running, cfg_running, cmd_after, cfg_after, gate_after;
+	bool changed, running, safe_to_collapse;
+};
+enum { SGR_OK, SGR_GUARD, SGR_IO, SGR_TIMEOUT, SGR_RESTORE };
+static inline bool
+sgr_poll(const struct sweet_gpu_clock_io *io, unsigned offset, uint32_t mask, uint32_t expect)
+{
+	for (unsigned us = 0; us < 500; us++) {
+		uint32_t v = io->read(io->cookie, false, offset);
+		if (v == 0xffffffffu) { return false; }
+		if ((v & mask) == expect) { return true; }
+		io->delay(1);
+	}
+	return false;
+}
+static inline bool
+sgr_configure(const struct sweet_gpu_clock_io *io, uint32_t cfg)
+{
+	uint32_t cmd = io->read(io->cookie, false, SGR_CMD);
+	if (cmd == 0xffffffffu || (cmd & (SGR_UPDATE | SGR_FORCE))) { return false; }
+	io->write(io->cookie, false, SGR_CFG, cfg);
+	if (io->read(io->cookie, false, SGR_CFG) != cfg) { return false; }
+	io->write(io->cookie, false, SGR_CMD, cmd | SGR_UPDATE);
+	return sgr_poll(io, SGR_CMD, SGR_UPDATE, 0);
+}
+static inline bool
+sgr_parent_bit(const struct sweet_gpu_clock_io *io, uint32_t bit)
+{
+	uint32_t v = io->read(io->cookie, true, SGR_GATE);
+	if (v == 0xffffffffu) { return false; }
+	io->write(io->cookie, true, SGR_GATE, (v & ~SGR_GATE_BIT) | bit);
+	v = io->read(io->cookie, true, SGR_GATE);
+	io->delay(10); /* BRANCH_HALT_DELAY, no independent halt register. */
+	return v != 0xffffffffu && (v & SGR_GATE_BIT) == bit;
+}
+static inline int
+sweet_gpu_gmu_root_cycle(const struct sweet_gpu_clock_io *io, struct sweet_gpu_clock_result *r)
+{
+	*r = (struct sweet_gpu_clock_result){0};
+	r->safe_to_collapse = true;
+	r->pll_mode = io->read(io->cookie, true, 0x0);
+	r->pll_l = io->read(io->cookie, true, 0x4);
+	r->pll_frac = io->read(io->cookie, true, 0x38);
+	r->pll_user = io->read(io->cookie, true, 0xc);
+	r->pll_opmode = io->read(io->cookie, true, 0x2c);
+	r->cmd_before = io->read(io->cookie, false, SGR_CMD);
+	r->cfg_before = io->read(io->cookie, false, SGR_CFG);
+	r->gate_before = io->read(io->cookie, true, SGR_GATE);
+	r->cx_before = io->read(io->cookie, false, SGR_CX);
+	r->gx_before = io->read(io->cookie, false, SGR_GX);
+	unsigned parent = (r->cfg_before >> 8) & 7u;
+	/* Fixed GPLL0: 19.2MHz*(31 + 0x4000/65536) = 600MHz. Div2 =>300MHz.
+	 * Both consumers must stay gated. Only restore known XO or GPLL0/div2.
+	 */
+	if (r->pll_mode == 0xffffffffu || r->pll_user == 0xffffffffu ||
+	    (r->pll_mode & (SGR_OFF | 5u)) != (SGR_OFF | 5u) ||
+	    r->pll_l != 31 || r->pll_frac != 0x4000 || r->pll_opmode != 1 ||
+	    !(r->pll_user & 1u) || r->gate_before == 0xffffffffu ||
+	    r->cmd_before == 0xffffffffu ||
+	    (r->cmd_before & (SGR_OFF | 0xf3u)) != SGR_OFF ||
+	    r->cfg_before == 0xffffffffu || (r->cfg_before & 0x103000u) ||
+	    (parent != 0 && parent != 6) || r->cx_before == 0xffffffffu ||
+	    r->gx_before == 0xffffffffu ||
+	    (r->cx_before & (SGR_OFF | 1u)) != SGR_OFF ||
+	    (r->gx_before & (SGR_OFF | 1u)) != SGR_OFF) { return SGR_GUARD; }
+	r->changed = true;
+	r->safe_to_collapse = false;
+	int result = SGR_IO;
+	if (!sgr_parent_bit(io, SGR_GATE_BIT)) { goto restore; }
+	/* Parent select6, HID2 =>300MHz/(1.5)=200MHz, no M/N or HW clock mode. */
+	if (!sgr_configure(io, (r->cfg_before & ~SGR_CFG_MASK) | 0x602u)) {
+		result = SGR_TIMEOUT;
+		goto restore;
+	}
+	uint32_t cmd = io->read(io->cookie, false, SGR_CMD);
+	if (cmd == 0xffffffffu) { goto restore; }
+	io->write(io->cookie, false, SGR_CMD, cmd | SGR_FORCE);
+	if (!sgr_poll(io, SGR_CMD, SGR_OFF | SGR_FORCE, SGR_FORCE)) {
+		result = SGR_TIMEOUT;
+		goto restore;
+	}
+	r->cmd_running = io->read(io->cookie, false, SGR_CMD);
+	r->cfg_running = io->read(io->cookie, false, SGR_CFG);
+	r->running = true;
+	result = SGR_OK;
+	uint32_t pll_now = io->read(io->cookie, true, 0x0);
+	if (r->cmd_running == 0xffffffffu ||
+	    r->cfg_running != ((r->cfg_before & ~SGR_CFG_MASK) | 0x602u) ||
+	    pll_now == 0xffffffffu) { result = SGR_IO; }
+	if (io->read(io->cookie, true, 0x4) != r->pll_l ||
+	    io->read(io->cookie, true, 0x38) != r->pll_frac ||
+	    (pll_now & (SGR_OFF | 5u)) != (SGR_OFF | 5u)) { result = SGR_IO; }
+	if (io->read(io->cookie, false, SGR_CX) != r->cx_before ||
+	    io->read(io->cookie, false, SGR_GX) != r->gx_before) { result = SGR_IO; }
+restore:
+	/* Never force-clear UPDATE or drop a parent while a configuration is
+	 * uncertain. On incomplete rollback leave CX and its parent powered.
+	 */
+	cmd = io->read(io->cookie, false, SGR_CMD);
+	if (cmd == 0xffffffffu || (cmd & SGR_UPDATE)) { return SGR_RESTORE; }
+	io->write(io->cookie, false, SGR_CMD, cmd & ~SGR_FORCE);
+	if (!sgr_poll(io, SGR_CMD, SGR_OFF | SGR_FORCE, SGR_OFF) ||
+	    !sgr_configure(io, r->cfg_before) ||
+	    !sgr_poll(io, SGR_CMD, SGR_OFF | SGR_FORCE | SGR_UPDATE, SGR_OFF)) {
+		return SGR_RESTORE;
+	}
+	if (!sgr_parent_bit(io, r->gate_before & SGR_GATE_BIT)) { return SGR_RESTORE; }
+	r->cmd_after = io->read(io->cookie, false, SGR_CMD);
+	r->cfg_after = io->read(io->cookie, false, SGR_CFG);
+	r->gate_after = io->read(io->cookie, true, SGR_GATE);
+	r->safe_to_collapse = r->cfg_after == r->cfg_before &&
+	    r->cmd_after != 0xffffffffu &&
+	    (r->cmd_after & (SGR_OFF | SGR_FORCE | SGR_UPDATE)) == SGR_OFF &&
+	    r->gate_after != 0xffffffffu &&
+	    (r->gate_after & SGR_GATE_BIT) == (r->gate_before & SGR_GATE_BIT) &&
+	    io->read(io->cookie, false, SGR_CX) == r->cx_before &&
+	    io->read(io->cookie, false, SGR_GX) == r->gx_before;
+	return r->safe_to_collapse ? result : SGR_RESTORE;
+}
+#endif
