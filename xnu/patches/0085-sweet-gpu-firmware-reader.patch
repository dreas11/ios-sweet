@@ -0,0 +1,57 @@
+/* Optional CPU-only firmware validation; no firmware is authenticated/executed. */
+#include <pexpert/boot.h>
+#include <pexpert/device_tree.h>
+#include <machine/machine_routines.h>
+#include <corecrypto/ccsha2.h>
+#include <corecrypto/ccdigest.h>
+#include "sweet_gpu_firmware.h"
+
+static bool
+sweet_gpu_fw_digest(const uint8_t *data, size_t size, const uint8_t *expected)
+{
+	uint8_t digest[32];
+	ccdigest(ccsha256_di(), size, data, digest);
+	return memcmp(digest, expected, sizeof(digest)) == 0;
+}
+
+static void
+sweet_gpu_fw_probe(void)
+{
+	int enabled = 0;
+	(void)PE_parse_boot_argn("sweetgpufw", &enabled, sizeof(enabled));
+	if (enabled != 1) { return; }
+	DTEntry entry;
+	const void *property;
+	unsigned property_size = 0;
+	if (SecureDTLookupEntry(NULL, "/chosen/memory-map", &entry) != kSuccess ||
+	    SecureDTGetProperty(entry, "GPUFirmware", &property, &property_size) != kSuccess ||
+	    property_size != 16 || !PE_state.bootArgs) {
+		printf("SWEET GPU: firmware mapping absent/invalid; no upload\n");
+		return;
+	}
+	const uint8_t *range = property;
+	uint64_t pa = sgfw_u64(range), size = sgfw_u64(range + 8);
+	const boot_args *args = PE_state.bootArgs;
+	/* Only boot-reserved RAM, through its existing normal-memory mapping.
+	 * Never map this RAM as Device memory; never translate any ELF p_paddr.
+	 */
+	if ((pa & 0x3fffu) || size < 256 || size > SWEET_GPU_FW_LIMIT ||
+	    pa < args->physBase || pa >= args->topOfKernelData ||
+	    size > args->topOfKernelData - pa || pa - args->physBase > args->memSize ||
+	    size > args->memSize - (pa - args->physBase)) {
+		printf("SWEET GPU: firmware outside reserved RAM; no upload\n");
+		return;
+	}
+	vm_offset_t va = ml_static_ptovirt((vm_offset_t)pa);
+	if (!va || ml_static_ptovirt((vm_offset_t)(pa + size - 1)) != va + size - 1) {
+		printf("SWEET GPU: firmware CPU mapping invalid; no upload\n");
+		return;
+	}
+	struct sweet_gpu_fw_image images[3];
+	if (!sweet_gpu_fw_parse((const uint8_t *)va, (size_t)size, sweet_gpu_fw_digest, images)) {
+		printf("SWEET GPU: firmware container/format/hash rejected; no upload\n");
+		return;
+	}
+	printf("SWEET GPU: firmware validated in CPU RAM: GMU=%lu SQE=%lu ZAP=%lu; no upload/authentication/execution\n",
+	    (unsigned long)images[0].size, (unsigned long)images[1].size, (unsigned long)images[2].size);
+}
