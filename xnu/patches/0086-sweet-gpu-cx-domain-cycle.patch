--- /dev/null
+++ b/bsd/dev/sweet_gpu_power.h
@@ -0,0 +1,98 @@
+/* Isolated CX-domain cycle. No rail votes, clocks, GX, core, GMU or DMA writes.
+ * Board sequence: Xiaomi 758bb7ef gdsc-regulator.c + sdmmagpie-gdsc.dtsi.
+ * Caller is the sole GPU power owner and has freshly verified inherited rails.
+ */
+#ifndef SWEET_GPU_POWER_H
+#define SWEET_GPU_POWER_H
+#include <stdint.h>
+#include <stdbool.h>
+#define SGC_CTRL 0x106cu
+#define SGC_HW 0x1540u
+#define SGC_GX 0x100cu
+#define SGC_AHB 0x1078u
+#define SGC_GMU 0x1098u
+#define SGC_ON (1u << 31)
+#define SGC_COLLAPSE 1u
+#define SGC_WAIT 0xf000u
+#define SGC_FIELDS 0xf007u
+struct sweet_gpu_power_io {
+	void *cookie;
+	uint32_t (*read)(void *, unsigned);
+	void (*write)(void *, unsigned, uint32_t);
+	void (*delay)(unsigned);
+};
+struct sweet_gpu_power_result {
+	uint32_t before, hw_before, gx_before, ahb_before, gmu_before;
+	uint32_t powered, hw_powered, ahb_powered;
+	uint32_t after, hw_after, gx_after, gmu_after;
+	bool requested, restored;
+};
+enum { SGC_OK, SGC_GUARD, SGC_IO, SGC_TIMEOUT, SGC_RESTORE };
+static inline bool
+sgc_write_check(const struct sweet_gpu_power_io *io, uint32_t value)
+{
+	io->write(io->cookie, SGC_CTRL, value);
+	uint32_t read = io->read(io->cookie, SGC_CTRL);
+	return read != 0xffffffffu && (read & SGC_FIELDS) == (value & SGC_FIELDS);
+}
+static inline int
+sweet_gpu_cx_cycle(const struct sweet_gpu_power_io *io, unsigned cx_level,
+    unsigned mx_level, unsigned gfx_level, struct sweet_gpu_power_result *out)
+{
+	*out = (struct sweet_gpu_power_result){0};
+	if (cx_level < 64 || mx_level < 192 || gfx_level != 0) { return SGC_GUARD; }
+	out->before = io->read(io->cookie, SGC_CTRL);
+	out->hw_before = io->read(io->cookie, SGC_HW);
+	out->gx_before = io->read(io->cookie, SGC_GX);
+	out->ahb_before = io->read(io->cookie, SGC_AHB);
+	out->gmu_before = io->read(io->cookie, SGC_GMU);
+	/* Don't take over an active domain, hardware-managed domain or override. */
+	if (out->before == 0xffffffffu || out->hw_before == 0xffffffffu ||
+	    out->gx_before == 0xffffffffu || out->ahb_before == 0xffffffffu ||
+	    out->gmu_before == 0xffffffffu ||
+	    (out->gmu_before & (SGC_ON | 1u)) != SGC_ON ||
+	    (out->before & (SGC_ON | 7u)) != SGC_COLLAPSE ||
+	    (out->hw_before & SGC_ON) ||
+	    (out->gx_before & (SGC_ON | 7u)) != SGC_COLLAPSE ||
+	    !(out->ahb_before & 1u)) { return SGC_GUARD; }
+	uint32_t prepared = (out->before & ~SGC_WAIT) | 0x8000u;
+	int result = SGC_IO;
+	bool collapsed, restored;
+	out->requested = true;
+	if (!sgc_write_check(io, prepared) || !sgc_write_check(io, prepared & ~SGC_COLLAPSE)) {
+		goto restore;
+	}
+	io->delay(1); /* At least 8 XO cycles, as downstream. */
+	result = SGC_TIMEOUT;
+	for (unsigned us = 0; us < 1000; us++) { /* Two bounded 500-us polls. */
+		uint32_t status = io->read(io->cookie, SGC_HW);
+		if (status == 0xffffffffu) { result = SGC_IO; break; }
+		if (status & SGC_ON) { result = SGC_OK; break; }
+		io->delay(1);
+	}
+	if (result == SGC_OK) {
+		io->delay(2); /* Memory staggering/clock recovery delay. */
+		out->powered = io->read(io->cookie, SGC_CTRL);
+		out->hw_powered = io->read(io->cookie, SGC_HW);
+		out->ahb_powered = io->read(io->cookie, SGC_AHB);
+		if (out->powered == 0xffffffffu || out->hw_powered == 0xffffffffu ||
+		    out->ahb_powered == 0xffffffffu || !(out->hw_powered & SGC_ON)) { result = SGC_IO; }
+	}
+restore:
+	/* Re-collapse with the eight-cycle setting before restoring the old wait.
+	 * CX DT deliberately skips OFF status polling (AOP may hold it on).
+	 * No firmware/DMA was started, so no work can race this collapse request.
+	 */
+	collapsed = sgc_write_check(io, prepared | SGC_COLLAPSE);
+	io->delay(1);
+	io->delay(100);
+	restored = sgc_write_check(io, out->before);
+	out->after = io->read(io->cookie, SGC_CTRL);
+	out->hw_after = io->read(io->cookie, SGC_HW);
+	out->gx_after = io->read(io->cookie, SGC_GX);
+	out->gmu_after = io->read(io->cookie, SGC_GMU);
+	out->restored = collapsed && restored && out->gx_after == out->gx_before &&
+	    out->gmu_after == out->gmu_before;
+	return out->restored ? result : SGC_RESTORE;
+}
+#endif
